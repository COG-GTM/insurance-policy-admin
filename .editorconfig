root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{xml,yml,yaml,json}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{cbl,cpy,jcl}]
# Legacy mainframe sources: leave indentation rules unset so editors do not reflow them.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
