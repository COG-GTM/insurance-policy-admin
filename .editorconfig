root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,xml}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[cobol/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false

[jcl/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false

[*.{cbl,cpy,jcl}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
