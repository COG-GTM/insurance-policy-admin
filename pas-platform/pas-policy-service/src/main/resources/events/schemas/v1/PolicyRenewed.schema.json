{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acme-insurance.example/pas/events/v1/PolicyRenewed.schema.json",
  "title": "PolicyRenewed v1",
  "description": "POLRNW renewal committed (AB-526, POST /api/v1/policies/{n}/renewals); POLRNW wrote no queue, only the POLRCONF map.",
  "x-topic": "pas.policy.events.v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "PolicyRenewed"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 0
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "previousPremium": {
          "type": [
            "number",
            "null"
          ]
        },
        "newPremium": {
          "type": [
            "number",
            "null"
          ]
        },
        "rateChangePct": {
          "type": [
            "number",
            "null"
          ]
        },
        "rateCapApplied": {
          "type": "boolean"
        },
        "previousEffectiveDate": {
          "type": "string",
          "format": "date"
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "format": "date"
        },
        "renewalCount": {
          "type": "integer"
        },
        "policyStatus": {
          "type": "string"
        },
        "uwStatus": {
          "type": "string"
        },
        "agentCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "branchCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "previousPremium",
        "newPremium",
        "rateChangePct",
        "rateCapApplied",
        "previousEffectiveDate",
        "effectiveDate",
        "expiryDate",
        "renewalCount",
        "policyStatus",
        "uwStatus",
        "agentCode",
        "branchCode"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "policyNumber",
    "policyVersion",
    "correlationId",
    "data"
  ]
}
