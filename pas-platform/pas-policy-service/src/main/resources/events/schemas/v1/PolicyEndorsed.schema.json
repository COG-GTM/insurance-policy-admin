{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acme-insurance.example/pas/events/v1/PolicyEndorsed.schema.json",
  "title": "PolicyEndorsed v1",
  "description": "POLEND endorsement committed (AB-526); replaces the ENDORSEMENT-AUDIT TS queue record.",
  "x-topic": "pas.policy.events.v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "PolicyEndorsed"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 0
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "endorsementSeq": {
          "type": "integer"
        },
        "endorsementType": {
          "type": [
            "string",
            "null"
          ]
        },
        "endorsementEffectiveDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "premiumAdjustment": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalPremium": {
          "type": [
            "number",
            "null"
          ]
        },
        "policyStatus": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "endorsementSeq",
        "endorsementType",
        "endorsementEffectiveDate",
        "premiumAdjustment",
        "totalPremium",
        "policyStatus",
        "effectiveDate",
        "expiryDate"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "policyNumber",
    "policyVersion",
    "correlationId",
    "data"
  ]
}
