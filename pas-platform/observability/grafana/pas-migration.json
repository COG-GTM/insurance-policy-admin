{
  "id": null,
  "uid": "pas-migration",
  "title": "PAS DB2 Migration",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Delta sync lag by table (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "pas_sync_lag_seconds", "legendFormat": "{{table}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Latest reconciliation differences",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "pas_recon_differences", "legendFormat": "{{table}} / {{kind}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Parallel-run differences recorded",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (artifact) (rate(pas_parallel_run_differences_total[5m]))", "legendFormat": "{{artifact}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Reverse sync passes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(pas_migration_reverse_passes_total[5m])", "legendFormat": "passes / second" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Delta sync lag alerts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "increase(pas_sync_lag_alerts_total[5m])", "legendFormat": "{{table}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Reverse sync lag (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "pas_sync_reverse_lag_seconds", "legendFormat": "{{table}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 7,
      "title": "Parallel-run untriaged and BUG counts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "pas_parallel_run_untriaged", "legendFormat": "untriaged" },
        { "expr": "pas_parallel_run_bugs", "legendFormat": "bugs" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 8,
      "title": "Latest reconciliation age (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "time() - pas_recon_last_run_timestamp", "legendFormat": "age" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }
    },
    {
      "id": 9,
      "title": "Batch job failures",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "increase(pas_batch_job_failures_total[15m])", "legendFormat": "failed jobs" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
    }
  ]
}
