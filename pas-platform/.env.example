PAS_ENV=local
PAS_DB_USERNAME=pas
PAS_DB_PASSWORD=changeme
# Local-only PII keys are generated by `make dev-env`; never reuse them outside development.
# PAS_PII_ENCRYPTION_KEY_ID and PAS_PII_ENCRYPTION_KEY_VERSION are generated with local defaults.
# PAS_PII_ENCRYPTION_KEY and PAS_PII_BLIND_INDEX_KEY are generated as distinct random keys.
# The reconciliation fingerprint key is independently generated by `make dev-env`.
PAS_MIGRATION_SOURCE_URL=jdbc:postgresql://acmeins-source:5432/acmeins
PAS_MIGRATION_SOURCE_USERNAME=acmeins_readonly
PAS_MIGRATION_SOURCE_PASSWORD=
PAS_MIGRATION_SOURCE_SSL=false
PAS_MIGRATION_REVERSE_USERNAME=acmeins_reverse
PAS_MIGRATION_REVERSE_PASSWORD=
# PAS_DB_HOST_PORT=5432
# PAS_KAFKA_HOST_PORT=9092
# PAS_POLICY_HTTP_PORT=8080
# PAS_BATCH_HTTP_PORT=8081
