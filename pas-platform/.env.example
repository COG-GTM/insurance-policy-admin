# Copy to pas-platform/.env; Compose loads that file automatically.
PAS_DB_USERNAME=pas
# Local-only default. Use a different value outside a disposable dev environment.
PAS_DB_PASSWORD=changeme
PAS_SPRING_PROFILES_ACTIVE=local

# PII field-encryption and blind-index keys for pas-policy-service (AB-521). Required, no default.
# Generate each locally with: openssl rand -base64 32   (never commit real values)
PAS_PII_ENCRYPTION_KEY=
PAS_PII_BLIND_INDEX_KEY=

# OIDC resource server (ADR 0001 D5). Local defaults match dev/dev-jwt.sh; real IdP values elsewhere.
PAS_OIDC_ISSUER_URI=https://pas-dev-issuer.local
PAS_OIDC_AUDIENCE=pas-api

# AB-527 extract delivery (pas-batch). SFTP only: public-key auth + known_hosts verification.
# The local compose stack sets PAS_TRANSFER_ENABLED=false (files stay in the container).
# Outside local dev, inject these from the secrets store; key files are mounted, never committed.
PAS_TRANSFER_ENABLED=false
PAS_SCHEDULE_ENABLED=false
# AB-529 DB2 -> PAS migration (pas-batch). Off by default; make reconcile sets these for its run.
PAS_MIGRATION_ENABLED=false
PAS_MIGRATION_SOURCE_URL=
PAS_MIGRATION_SOURCE_USERNAME=
PAS_MIGRATION_SOURCE_PASSWORD=
PAS_MIGRATION_SCHEDULE_ENABLED=false
PAS_SFTP_KNOWN_HOSTS_FILE=
PAS_CLAIMS_SFTP_HOST=
PAS_CLAIMS_SFTP_USERNAME=
PAS_CLAIMS_SFTP_PRIVATE_KEY_FILE=
PAS_CLAIMS_SFTP_PRIVATE_KEY_PASSPHRASE=
PAS_CLAIMS_SFTP_REMOTE_DIR=/claims/import
PAS_ACTUARIAL_SFTP_HOST=
PAS_ACTUARIAL_SFTP_USERNAME=
PAS_ACTUARIAL_SFTP_PRIVATE_KEY_FILE=
PAS_ACTUARIAL_SFTP_PRIVATE_KEY_PASSPHRASE=
PAS_ACTUARIAL_SFTP_REMOTE_DIR=/actuarial/data

# Host-side ports for local services (defaults shown).
PAS_POLICY_HTTP_PORT=8080
PAS_BATCH_HTTP_PORT=8081
PAS_POSTGRES_PORT=5432
PAS_KAFKA_PORT=9092

# Loopback only by default. Setting 0.0.0.0 exposes unauthenticated local services
# and the local-only database password on the network.
PAS_BIND_ADDRESS=127.0.0.1
# host name/IP remote Kafka clients use; set it when PAS_BIND_ADDRESS is not loopback.
PAS_KAFKA_ADVERTISED_HOST=localhost

PAS_POSTGRES_IMAGE=postgres:16
PAS_KAFKA_IMAGE=apache/kafka:3.9.1

# Rating factor set (AB-522): PARITY reproduces PREMBAT; FILED is a business decision (OQ-04)
PAS_RATING_FACTOR_SET=PARITY
