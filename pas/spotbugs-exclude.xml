<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- The filter rejects non-matching request values before echoing this header; SpotBugs does not infer the regex validation. -->
    <Match>
        <Class name="com.acme.insurance.pas.observability.CorrelationIdFilter"/>
        <Method name="doFilterInternal"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
</FindBugsFilter>
