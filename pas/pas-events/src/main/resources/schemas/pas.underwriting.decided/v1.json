{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acme:pas:events:pas.underwriting.decided:v1",
  "title": "pas.underwriting.decided v1",
  "description": "PAS domain event envelope (ADR 0001 D4, AB-528). Immutable once released: a breaking change is a new version file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "policyNumber",
    "occurredAt",
    "correlationId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "eventType": {
      "const": "pas.underwriting.decided"
    },
    "schemaVersion": {
      "const": 1
    },
    "policyNumber": {
      "type": "string",
      "maxLength": 12
    },
    "occurredAt": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyNumber",
        "decisionDate",
        "decisionCode",
        "riskScore",
        "decisionReason",
        "referral",
        "override",
        "decidedBy"
      ],
      "properties": {
        "policyNumber": {
          "type": "string",
          "maxLength": 12
        },
        "decisionDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "decisionCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2
        },
        "riskScore": {
          "type": [
            "integer",
            "null"
          ]
        },
        "decisionReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "referral": {
          "type": "boolean"
        },
        "override": {
          "type": "boolean"
        },
        "decidedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        }
      }
    }
  }
}
