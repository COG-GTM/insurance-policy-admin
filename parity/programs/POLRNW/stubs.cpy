       PX-STUB-ASKTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-FORMATTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-RECEIVE.
           MOVE PX-IN-RECEIVE-RESP TO WS-RESPONSE-CODE
           IF WS-RESPONSE-CODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
           END-IF
           EXIT.
       PX-STUB-SELECT-POLICY.
           MOVE PX-IN-POLICY-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
               MOVE PX-IN-POLICY-POLICY-TYPE TO POLICY-TYPE
               MOVE PX-IN-POLICY-STATUS TO POLICY-STATUS
               MOVE PX-IN-POLICY-TOTAL-PREMIUM TO POLICY-TOTAL-PREMIUM
               MOVE PX-IN-POLICY-EXPIRY-DATE TO POLICY-EXPIRY-DATE
               MOVE PX-IN-POLICY-RENEWAL-COUNT TO POLICY-RENEWAL-COUNT
               MOVE PX-IN-POLICY-UW-STATUS TO POLICY-UW-STATUS
           END-IF
           EXIT.
       PX-STUB-SELECT-CLAIMS.
           MOVE 0 TO SQLCODE
           MOVE PX-IN-OPEN-CLAIMS TO WS-SQLCODE
           EXIT.
       PX-STUB-UPDATE-POLICY.
           MOVE PX-IN-POLICY-UPDATE-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               PERFORM PX-EMIT-POLICYUPDATE
           END-IF
           EXIT.
       PX-STUB-UPDATE-COVERAGES.
           MOVE PX-IN-COVERAGE-UPDATE-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               PERFORM PX-EMIT-COVERAGEUPDATE
           END-IF
           EXIT.
       PX-STUB-SEND-MAP.
           MOVE 'POLRCONF' TO PX-EVENT-VALUE
           PERFORM PX-EMIT-SCREEN
           EXIT.
       PX-STUB-SEND-TEXT.
           PERFORM PX-EMIT-ERROR
           EXIT.
       PX-STUB-RETURN.
           PERFORM PX-FINISH
           STOP RUN.
