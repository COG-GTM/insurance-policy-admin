       PX-STUB-ASKTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-FORMATTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-RECEIVE.
           MOVE PX-IN-RECEIVE-RESP TO WS-RESPONSE-CODE
           IF WS-RESPONSE-CODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
           END-IF
           EXIT.
       PX-STUB-SELECT-POLICY.
           MOVE PX-IN-POLICY-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
               MOVE PX-IN-POLICY-STATUS TO POLICY-STATUS
               MOVE PX-IN-POLICY-EFFECTIVE-DATE TO POLICY-EFFECTIVE-DATE
               MOVE PX-IN-POLICY-EXPIRY-DATE TO POLICY-EXPIRY-DATE
               MOVE PX-IN-POLICY-TOTAL-PREMIUM TO POLICY-TOTAL-PREMIUM
           END-IF
           EXIT.
       PX-STUB-SELECT-ENDORSEMENT-SEQ.
           MOVE PX-IN-MAX-ENDORSEMENT-SEQ TO WS-ENDORSEMENT-SEQ
           ADD 1 TO WS-ENDORSEMENT-SEQ
           MOVE 0 TO SQLCODE
           EXIT.
       PX-STUB-INSERT-ENDORSEMENT.
           MOVE PX-IN-INSERT-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               PERFORM PX-EMIT-ENDORSEMENT
           END-IF
           EXIT.
       PX-STUB-UPDATE-POLICY.
           MOVE PX-IN-POLICY-UPDATE-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               PERFORM PX-EMIT-POLICYUPDATE
           END-IF
           EXIT.
       PX-STUB-WRITEQ-TS.
           PERFORM PX-EMIT-AUDIT
           EXIT.
       PX-STUB-SEND-MAP.
           MOVE 'POLECONF' TO PX-EVENT-VALUE
           PERFORM PX-EMIT-SCREEN
           EXIT.
       PX-STUB-SEND-TEXT.
           PERFORM PX-EMIT-ERROR
           EXIT.
       PX-STUB-RETURN.
           PERFORM PX-FINISH
           STOP RUN.
