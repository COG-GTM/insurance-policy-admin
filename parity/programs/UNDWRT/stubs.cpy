       PX-STUB-ASKTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-FORMATTIME.
           MOVE PX-IN-CURRENT-DATE TO WS-CURRENT-DATE
           EXIT.
       PX-STUB-RECEIVE.
           MOVE PX-IN-RECEIVE-RESP TO WS-RESPONSE-CODE
           IF WS-RESPONSE-CODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
           END-IF
           EXIT.
       PX-STUB-SELECT-POLICY.
           MOVE PX-IN-POLICY-SQLCODE TO SQLCODE
           IF SQLCODE = 0
               MOVE PX-IN-POLICY-POLICY-NUMBER TO POLICY-NUMBER
               MOVE PX-IN-POLICY-POLICY-TYPE TO POLICY-TYPE
               MOVE PX-IN-POLICY-TOTAL-PREMIUM TO POLICY-TOTAL-PREMIUM
               MOVE PX-IN-POLICY-COVERAGE-LIMIT TO POLICY-LIMIT
               MOVE PX-IN-POLICY-BRANCH-CODE TO POLICY-BRANCH-CODE
               MOVE PX-IN-CUSTOMER-CUST-TYPE TO CUST-TYPE
               MOVE PX-IN-CUSTOMER-CREDIT-SCORE TO CUST-CREDIT-SCORE
               MOVE PX-IN-CUSTOMER-RISK-TIER TO CUST-RISK-TIER
           END-IF
           EXIT.
       PX-STUB-SELECT-CLAIMS.
           MOVE 0 TO SQLCODE
           MOVE PX-IN-CLAIMS-COUNT TO WS-CLAIM-COUNT
           MOVE PX-IN-CLAIMS-TOTAL-INCURRED TO WS-TOTAL-INCURRED
           EXIT.
       PX-STUB-SELECT-ACCUM.
           MOVE 0 TO SQLCODE
           MOVE PX-IN-BRANCH-ACCUMULATED-LIMIT TO WS-ACCUM-LIMIT
           EXIT.
       PX-STUB-INSERT-DECISION.
           MOVE 0 TO SQLCODE
           PERFORM PX-EMIT-DECISION
           EXIT.
       PX-STUB-UPDATE-POLICY.
           MOVE 0 TO SQLCODE
           PERFORM PX-EMIT-POLICYUPDATE
           EXIT.
       PX-STUB-WRITEQ-TD.
           PERFORM PX-EMIT-NOTIFICATION
           EXIT.
       PX-STUB-SEND-MAP.
           MOVE 'UWRTRES' TO PX-EVENT-VALUE
           PERFORM PX-EMIT-SCREEN
           EXIT.
       PX-STUB-SEND-TEXT.
           PERFORM PX-EMIT-ERROR
           EXIT.
       PX-STUB-RETURN.
           PERFORM PX-FINISH
           STOP RUN.
